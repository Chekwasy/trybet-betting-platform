{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/auth/layout,_N_T_/auth/fpwd/layout,_N_T_/auth/fpwd/page,_N_T_/auth/fpwd"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/auth/fpwd/__PAGE__",
    "/auth/fpwd",
    "/auth",
    "/_index",
    "/_head"
  ]
}